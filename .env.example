# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vpn_user
POSTGRES_PASSWORD=secure_password_change_me
POSTGRES_DB=vpn_dev
POSTGRES_SSL_MODE=disable

# Server Configuration
SERVER_PORT=8080
SERVER_ENV=development

# WireGuard Configuration (Legacy Single Server)
WG_INTERFACE_NAME=wg0
WG_SERVER_PUBLIC_KEY=cWC4I+0L7klYTozF8pFDZUKC4fGt3tEuCakfWYghN0Y=
WG_SERVER_PRIVATE_KEY=uHXTbxAQJ3kO2gXwGui3p+/F1XYhYccXe1jBW/3wEnI=
WG_SERVER_ENDPOINT=192.168.1.71:51820
WG_LISTEN_PORT=51820

# Multi-Server VPS Configuration
# Enable multi-server mode - routes traffic through remote VPS agents
ENABLE_MULTI_SERVER=true

# VPS Agent Connection Settings
# Each server in the 'servers' table has its own agent_url and api_key
# Agent is typically running on the VPS to manage WireGuard
# Example VPS agents: wg-agent, wireguard-api, etc.
VPS_AGENT_TIMEOUT=30s
VPS_AGENT_RETRY_COUNT=3
VPS_AGENT_RETRY_DELAY=5s

# Example Server Configuration (can be managed via API or seeded)
# Server 1: US - New York
VPS_SERVER_1_ID=us-newyork
VPS_SERVER_1_NAME=New York
VPS_SERVER_1_LOCATION=New York, USA
VPS_SERVER_1_REGION=us-east
VPS_SERVER_1_COUNTRY=US
VPS_SERVER_1_PUBLIC_IP=203.0.113.1
VPS_SERVER_1_AGENT_URL=https://wg-agent-nyc.example.com
VPS_SERVER_1_AGENT_KEY=your_encrypted_api_key_here
VPS_SERVER_1_WG_PUBLIC_KEY=QGF4I+0L7klYTozF8pFDZUKC4fGt3tEuCakfWYghN0Y=
VPS_SERVER_1_NETWORK_CIDR=192.168.88.0/24
VPS_SERVER_1_MAX_CLIENTS=250

# Server 2: EU - Paris
VPS_SERVER_2_ID=eu-paris
VPS_SERVER_2_NAME=Paris
VPS_SERVER_2_LOCATION=Paris, France
VPS_SERVER_2_REGION=eu-west
VPS_SERVER_2_COUNTRY=FR
VPS_SERVER_2_PUBLIC_IP=203.0.113.2
VPS_SERVER_2_AGENT_URL=https://wg-agent-paris.example.com
VPS_SERVER_2_AGENT_KEY=your_encrypted_api_key_here
VPS_SERVER_2_WG_PUBLIC_KEY=cWC4I+0L7klYTozF8pFDZUKC4fGt3tEuCakfWYghN0Y=
VPS_SERVER_2_NETWORK_CIDR=192.168.89.0/24
VPS_SERVER_2_MAX_CLIENTS=250

# Security Settings
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=1m
MAX_REQUEST_SIZE=1048576
